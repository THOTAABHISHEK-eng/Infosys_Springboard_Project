{
  "manifest_version": 3,
  "name": "Current & Previous Website Usage Tracker",
  "version": "1.0.0",
  "description": "Lightweight real-time website activity and usage duration tracker with activity timeline and daily comparison statistics.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Website Usage Tracker",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  }
}
